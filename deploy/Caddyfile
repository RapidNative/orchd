# Caddy front door.
#
# cloud.rapidnative.com — behind Cloudflare, self-signed origin cert (tls internal).
# tinbase.dev subdomains — direct A record, real Let's Encrypt certs:
#   admin.tinbase.dev -> admin UI (+ same-origin /api proxy)
#   api.tinbase.dev   -> control-plane API (key-protected)
#   *.tinbase.dev     -> gateway (host-based workload routing), cert issued on
#                        demand, gated by orchd's /internal/tls-allow so only real
#                        project hosts (and admin/api) can trigger issuance.
{
	auto_https disable_redirects
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-allow
	}
}

(site) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /w/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle_path /admin* {
		root * /opt/tinbase-cloud/admin
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /opt/tinbase-cloud/site
		encode gzip
		file_server
	}
}

http://cloud.rapidnative.com {
	import site
}

https://cloud.rapidnative.com {
	tls internal
	import site
}

admin.tinbase.dev {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /opt/tinbase-cloud/admin
		try_files {path} /index.html
		file_server
	}
}

api.tinbase.dev {
	reverse_proxy 127.0.0.1:8080
}

*.tinbase.dev {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8081
}
