# Caddy front door.
#
# cloud.rapidnative.com — behind Cloudflare, self-signed origin cert (tls internal).
# *.rnproject.dev — ONE wildcard certificate via DNS-01 (Vercel DNS plugin;
#   VERCEL_API_TOKEN from the caddy unit's EnvironmentFile). Per-hostname
#   issuance is not viable here: every project mints several hostnames and
#   Let's Encrypt caps new certs at 50/week per registered domain (hit on
#   2026-08-08 — handshakes for uncached hosts then hang on issuance).
# *.tinbase.dev — low churn, keeps per-hostname on-demand TLS gated by orchd's
#   /internal/tls-allow.
{
	auto_https disable_redirects
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-allow
	}
}

(cloudsite) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /w/* {
		reverse_proxy 127.0.0.1:8081
	}
	# admin UI is a SPA with absolute asset paths, so it lives at its own root.
	handle /admin* {
		redir https://admin.rnproject.dev 302
	}
	handle {
		root * /opt/orchd/site
		encode gzip
		file_server
	}
}

http://cloud.rapidnative.com {
	import cloudsite
}

https://cloud.rapidnative.com {
	tls internal
	import cloudsite
}

# Wildcard front for a base domain. {args[0]} = the base domain (e.g. rnproject.dev).
# admin.<base> serves the panel, api.<base> the control API; every other subdomain
# is a workload host proxied to the gateway. TLS comes from the importing site
# block (wildcard DNS-01 or on-demand per-host).
(wildcard) {
	@admin host admin.{args[0]}
	@api host api.{args[0]}

	handle @admin {
		handle_path /api/* {
			reverse_proxy 127.0.0.1:8080
		}
		handle {
			root * /opt/orchd/admin
			try_files {path} /index.html
			file_server
		}
	}
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	# Site-local drop-ins: /etc/caddy/conf.d/<base>/*.caddy can claim hosts
	# before the default gateway handle (e.g. forward a host pattern to an
	# external service). The directory is not tracked in this repo and may be
	# empty; deploys leave it alone.
	import /etc/caddy/conf.d/{args[0]}/*.caddy

	# every other subdomain -> gateway (host-based workload routing)
	handle {
		reverse_proxy 127.0.0.1:8081
	}
}

*.rnproject.dev {
	tls {
		dns vercel {env.VERCEL_API_TOKEN}
		resolvers 1.1.1.1
	}
	import wildcard rnproject.dev
}

*.tinbase.dev {
	tls {
		on_demand
	}
	import wildcard tinbase.dev
}
