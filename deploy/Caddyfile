# Caddy front door.
#
# cloud.rapidnative.com — behind Cloudflare, self-signed origin cert (tls internal).
# *.rnproject.dev / *.tinbase.dev — direct A records; a single on-demand-TLS
#   block per domain issues real Let's Encrypt certs per hostname on the TLS
#   handshake, gated by orchd's /internal/tls-allow (so only admin/api/real
#   workload hosts get a cert). Host matchers dispatch admin/api; everything else
#   is a workload on the gateway.
{
	auto_https disable_redirects
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-allow
	}
}

(cloudsite) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /w/* {
		reverse_proxy 127.0.0.1:8081
	}
	# admin UI is a SPA with absolute asset paths, so it lives at its own root.
	handle /admin* {
		redir https://admin.rnproject.dev 302
	}
	handle {
		root * /opt/orchd/site
		encode gzip
		file_server
	}
}

http://cloud.rapidnative.com {
	import cloudsite
}

https://cloud.rapidnative.com {
	tls internal
	import cloudsite
}

# Wildcard front for a base domain. {args[0]} = the base domain (e.g. rnproject.dev).
# admin.<base> serves the panel, api.<base> the control API; every other subdomain
# is a workload host proxied to the gateway.
(wildcard) {
	tls {
		on_demand
	}

	@admin host admin.{args[0]}
	@api host api.{args[0]}

	handle @admin {
		handle_path /api/* {
			reverse_proxy 127.0.0.1:8080
		}
		handle {
			root * /opt/orchd/admin
			try_files {path} /index.html
			file_server
		}
	}
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	# every other subdomain -> gateway (host-based workload routing)
	handle {
		reverse_proxy 127.0.0.1:8081
	}
}

*.rnproject.dev {
	import wildcard rnproject.dev
}

*.tinbase.dev {
	import wildcard tinbase.dev
}
