# Caddy front door.
#
# cloud.rapidnative.com — behind Cloudflare, self-signed origin cert (tls internal).
# *.tinbase.dev — direct A record; a single on-demand-TLS block issues real
#   Let's Encrypt certs per hostname on the TLS handshake, gated by orchd's
#   /internal/tls-allow (so only admin/api/real workload hosts get a cert).
#   Host matchers dispatch admin/api; everything else is a workload on the gateway.
{
	auto_https disable_redirects
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-allow
	}
}

(cloudsite) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /w/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle_path /admin* {
		root * /opt/tinbase-cloud/admin
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /opt/tinbase-cloud/site
		encode gzip
		file_server
	}
}

http://cloud.rapidnative.com {
	import cloudsite
}

https://cloud.rapidnative.com {
	tls internal
	import cloudsite
}

*.tinbase.dev {
	tls {
		on_demand
	}

	@admin host admin.tinbase.dev
	@api host api.tinbase.dev

	handle @admin {
		handle_path /api/* {
			reverse_proxy 127.0.0.1:8080
		}
		handle {
			root * /opt/tinbase-cloud/admin
			try_files {path} /index.html
			file_server
		}
	}
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	# every other subdomain -> gateway (host-based workload routing)
	handle {
		reverse_proxy 127.0.0.1:8081
	}
}
