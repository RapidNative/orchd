# /etc/systemd/system/orchd.service (production instance)
[Unit]
Description=orchd orchestrator (production)
After=docker.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/orchd
Environment=ORCHD_DRIVER=docker
Environment=ORCHD_DATA_ROOT=/opt/orchd/data
Environment=ORCHD_STATE_SQLITE=/opt/orchd/data/state/orchd.db
Environment=ORCHD_IMAGE=tinbase:0.18.0
Environment=ORCHD_WORKLOAD_ENV=npm_config_registry=http://172.17.0.1:4873,NPM_CONFIG_REGISTRY=http://172.17.0.1:4873
Environment=ORCHD_BUILD_ENV=npm_config_registry=http://172.17.0.1:4873,NPM_CONFIG_REGISTRY=http://172.17.0.1:4873
Environment=ORCHD_HOST_ALIASES=esm.reactnative.run=10.201.255.1
# Where tinbase workloads send auth email: the platform relay in
# global-services. The password is each project's own service key, read from
# its env, so only the destination is set here. The relay holds the one
# provider key, meters every project against its ceilings, and is the only
# path to the provider a tenant has.
# The relay listens on 2525, not the usual 587 - nothing answers on 587, and a
# tenant pointed there fails to send with no error until someone reads a log.
Environment=ORCHD_TINBASE_SMTP_HOST=services.rapidnative.app
Environment=ORCHD_TINBASE_SMTP_PORT=2525
Environment=ORCHD_TINBASE_SMTP_ADMIN_EMAIL=noreply@rnproject.dev
Environment=ORCHD_TINBASE_SMTP_SENDER_NAME=RapidNative
# Extra env for tinbase workloads only (never the tenant api container), from
# a root-only file, as ORCHD_TINBASE_ENV=K=V,K2=V2. Nothing is needed there
# today. It must NOT carry TINBASE_RESEND_API_KEY: with the relay above set,
# orchd refuses to boot rather than put a provider key into every container.
EnvironmentFile=-/opt/orchd/secrets/tinbase.env
Environment=ORCHD_DOCKER_RUNTIME=runsc
Environment=ORCHD_IDLE_TIMEOUT=15m
Environment=ORCHD_DEV_CPUS=4
Environment=ORCHD_DEV_MEM_MB=4096
Environment=ORCHD_API_KEY_FILE=/opt/orchd/secrets/admin.key
Environment=ORCHD_BASE_DOMAIN=rapidnative.app
Environment=ORCHD_ALT_DOMAINS=rnproject.dev,tinbase.dev,rapidnative.dev
Environment=ORCHD_PUBLIC_SCHEME=https
Environment=ORCHD_BACKUP_DIR=/opt/orchd/backups
Environment=ORCHD_BACKUP_INTERVAL=24h
Environment=ORCHD_BACKUP_RETAIN=7
Environment=ORCHD_METRICS_INTERVAL=15s
Environment=ORCHD_RATE_LIMIT=600
ExecStart=/opt/orchd/orchd
Restart=on-failure
KillMode=process

[Install]
WantedBy=multi-user.target
