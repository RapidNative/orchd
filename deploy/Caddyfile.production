# Production orchd Caddyfile.
#
# rapidnative.app — the production pretty-domain base (<slug>.rapidnative.app).
# Staging previews live on rapidnative.dev (separate orchd instance).
#
# When a project hasn't been provisioned on production yet, we temporarily
# redirect to the staging instance so existing links keep working during
# the domain migration.
{
	auto_https disable_redirects
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-allow
	}
}

(cloudsite) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /w/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /admin* {
		redir https://admin.rapidnative.app 302
	}
	handle {
		root * /opt/orchd/site
		encode gzip
		file_server
	}
}

(wildcard) {
	@admin host admin.{args[0]}
	@api host api.{args[0]}

	handle @admin {
		handle_path /api/* {
			reverse_proxy 127.0.0.1:8080
		}
		handle {
			root * /opt/orchd/admin
			try_files {path} /index.html
			file_server
		}
	}
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	import /etc/caddy/conf.d/{args[0]}/*.caddy

	# every other subdomain -> gateway (host-based workload routing)
	# If the gateway has no route (X-Orchd-No-Route header), transparently
	# proxy to the staging orchd instance instead of redirecting. A redirect
	# breaks CORS on POST/PUT (cross-origin 302 → browser rejects).
	handle {
		reverse_proxy 127.0.0.1:8081 {
			@no_route header X-Orchd-No-Route 1
			handle_response @no_route {
				# Proxy to staging; keep the original .rapidnative.app host —
				# the staging gateway resolves it via alt-domain alias lookup.
				reverse_proxy {env.ORCHD_STAGING_UPSTREAM} {
					header_up Host {http.request.host}
					transport http {
						tls
						tls_server_name {http.request.host}
					}
				}
			}
		}
	}
}

# rapidnative.app — production pretty-domain base. Wildcard DNS-01 cert.
*.rapidnative.app {
	tls {
		dns vercel {env.VERCEL_API_TOKEN}
		resolvers 1.1.1.1
	}
	import wildcard rapidnative.app
}

http://*.rapidnative.app {
	import wildcard rapidnative.app
}
