# /etc/systemd/system/caddy.service
# TimeoutStopSec bounds Caddy's "eternal" shutdown grace so restarts do not hang.
# HOME gives it a stable cert/ACME storage dir (/root/.local/share/caddy).
[Unit]
Description=Caddy (orchd front door)
After=network.target

[Service]
ExecStart=/usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
TimeoutStopSec=20
Environment=HOME=/root
# VERCEL_API_TOKEN for the *.rnproject.dev wildcard DNS-01 challenge (file is
# root-only under /opt/orchd/secrets/, never tracked in the repo)
EnvironmentFile=-/opt/orchd/secrets/caddy.env
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
